# Copiare in .env.local e inserire le credenziali del servizio email.
# Per Gmail usare una password per app, non la password ordinaria.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Cloudflare: creare un widget Managed; solo questa chiave e pubblica.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Host autorizzati separati da virgola, senza schema o percorso.
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1
# Redis REST condiviso (Upstash / Vercel Marketplace), solo lato server.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Segreto casuale stabile per anonimizzare gli IP nelle chiavi Redis.
RATE_LIMIT_IP_SALT=
